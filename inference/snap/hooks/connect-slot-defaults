# <11>Jun 26 18:31:02 snap.inference.hook.connect-slot-defaults: /snap/inference/3/meta/hooks/connect-slot-defaults: line 13: /var/snap/inference/common/share/defaults/hello.txt: No such file or directory
# -----)
