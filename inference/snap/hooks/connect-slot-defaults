#!/bin/bash

tag="snap.$SNAP_INSTANCE_NAME.hook.connect-slot-defaults"

# Redirect stdout to stdout+syslog
exec 1> >(tee >(logger --tag=$tag))
# Redirect stderr to stderr+syslog
exec 2> >(logger --stderr --priority error --tag=$tag)


echo "Connect slot for snap $SNAP_INSTANCE_NAME"

# This isn't possible. It looks like the mount point for the slot isn't created yet. So we can't write to it.
